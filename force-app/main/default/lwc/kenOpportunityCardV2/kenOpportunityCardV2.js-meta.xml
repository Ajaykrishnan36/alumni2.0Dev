<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 - Opportunity Card</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id"/>
            <property name="title" type="String" label="Title"/>
            <property name="category" type="String" label="Category"/>
            <property name="shortDesc" type="String" label="Short Description"/>
            <property name="raised" type="Integer" label="Amount Raised" default="0"/>
            <property name="target" type="Integer" label="Target Amount"/>
            <property name="contributors" type="Integer" label="Contributors" default="0"/>
            <property name="daysLeft" type="Integer" label="Days Left"/>
            <property name="image" type="String" label="Image URL"/>
            <property name="isOngoing" type="Boolean" label="Ongoing Fund" default="false"/>
            <property name="approved" type="Boolean" label="Approved" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>