<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 - Mentor Card</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id"/>
            <property name="name" type="String" label="Name"/>
            <property name="title" type="String" label="Title / Role"/>
            <property name="company" type="String" label="Company"/>
            <property name="location" type="String" label="Location"/>
            <property name="expertise" type="String" label="Expertise"/>
            <property name="batch" type="String" label="Batch"/>
            <property name="photoUrl" type="String" label="Photo URL"/>
            <property name="willing" type="Boolean" label="Willing" default="false"/>
            <property name="sessionCount" type="Integer" label="Session Count" default="0"/>
            <property name="rating" type="String" label="Rating"/>
            <property name="initial" type="String" label="Avatar Initial"/>
            <property name="avatarColor" type="String" label="Avatar Color"/>
            <property name="tag" type="String" label="Tag"/>
            <property name="role" type="String" label="Card Role (mentor/mentee)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>