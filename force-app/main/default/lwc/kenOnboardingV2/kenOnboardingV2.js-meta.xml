<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 — Profile Setup Wizard</masterLabel>
    <description>4-step onboarding wizard: Basic Profile, Education, Employment, Engagement &amp; Contributions.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="userFirstName" type="String" label="User First Name" default=""/>
            <property name="userLastName" type="String" label="User Last Name" default=""/>
            <property name="userEmail" type="String" label="User Email" default=""/>
            <property name="institutionLogoUrl" type="String" label="Institution Logo URL" default=""/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>