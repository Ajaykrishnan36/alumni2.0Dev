<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Ken Feedback Responses</masterLabel>
    <description>Drop-in viewer that shows the feedback responses tied to any record.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" label="Card Title" default="Feedback Responses"/>
            <property name="templateId" type="String" label="Template Id (bulk mode, optional)"/>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id (individual mode)"/>
            <property name="templateId" type="String" label="Template Id (bulk mode)"/>
            <property name="title" type="String" label="Card Title" default="Feedback Responses"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>