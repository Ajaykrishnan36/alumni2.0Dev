<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 — Success Toast</masterLabel>
    <description>Reusable success modal with green checkmark seal. Used for "Password Updated", "Career Info Saved", "Education Added", etc.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="header" type="String" label="Header" default="Password Updated!"/>
            <property name="content" type="String" label="Content" default=""/>
            <property name="showContent" type="Boolean" label="Show Content" default="false"/>
            <property name="autoDismissMs" type="Integer" label="Auto-dismiss (ms, 0 = manual)" default="0"/>
            <property name="dismissible" type="Boolean" label="Show close button" default="true"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>