<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 — Reset Password</masterLabel>
    <description>Set a new permanent password after first login with a temporary password.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="institutionName" type="String" label="Institution Name" default="Name of the Institute"/>
            <property name="institutionLogoUrl" type="String" label="Institution Logo URL" default=""/>
            <property name="title" type="String" label="Title" default="Reset your password"/>
            <property name="subtitle" type="String" label="Subtitle" default="Create a new password for your alumni account. Make it at least 8 characters."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>