<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Alumni 2.0 — Forgot Password (V2)</masterLabel>
    <description>Violet-themed forgot-password page that triggers the standard Salesforce community password reset email.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="institutionName" type="String" label="Institution Name" default="Name of the Institute"/>
            <property name="institutionLogoUrl" type="String" label="Institution Logo URL" default=""/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>