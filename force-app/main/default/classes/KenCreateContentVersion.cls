/**
 * @description Utility class for creating ContentVersion records from
 *              Base64-encoded data and generating public download URLs
 *              using ContentDistribution.
 */
public with sharing class KenCreateContentVersion {
    
    /**
     *  @description Creates a single ContentVersion from a Base64 string and
     *              returns a downloadable URL via ContentDistribution.
     *
     * @param title          File title and client path.
     * @param base64String   Base64-encoded file data.
     * @return               Content download URL (or exception message on error).
     */
    @AuraEnabled
    public static String createContentVersion(String title, String base64String) {
        try{
            Blob decodedData = EncodingUtil.base64Decode(base64String);
            ContentVersion newVersion = new ContentVersion();
            newVersion.Title = title;
            newVersion.PathOnClient = title;
            newVersion.VersionData = decodedData;

            if (Schema.sObjectType.ContentVersion.isCreateable()) {
                insert newVersion;
            }
            List<ContentVersion> documentId = [SELECT Id, ContentDocumentId, ContentUrl, ContentBodyId, Title, OwnerId, CreatedDate, FileType FROM ContentVersion WHERE Id=:newVersion.Id WITH SYSTEM_MODE];

            ContentDistribution distribution = new ContentDistribution();
            distribution.Name = title;
            distribution.ContentVersionId  = documentId[0].Id;
            distribution.PreferencesLinkLatestVersion = true;
            distribution.PreferencesAllowViewInBrowser = true;
            distribution.PreferencesNotifyOnVisit = false;
            Database.insert(distribution, false, AccessLevel.SYSTEM_MODE);
            
            ContentDistribution contentDistribution = [SELECT Id, CreatedDate, OwnerId, ContentVersionId, ContentDocumentId, RelatedRecordId, DistributionPublicUrl, ContentDownloadUrl, PdfDownloadUrl, PreferencesLinkLatestVersion, PreferencesAllowPDFDownload, PreferencesAllowOriginalDownload, PreferencesPasswordRequired FROM ContentDistribution WHERE Id =:distribution.Id WITH SYSTEM_MODE LIMIT 1];
			String distributionPublicurl = contentDistribution?.ContentDownloadUrl;
            return distributionPublicurl;
        }Catch(Exception ex){
            return ex.getMessage();
        }
    }   

    /**
     * @description Generates public download URLs for ContentVersions that ALREADY
     *              exist, keyed by ContentVersion Id.
     *
     *              The two methods above create the file as well, which is no use
     *              when the caller has already inserted it and linked it to a
     *              record - calling them would produce a second, orphaned copy.
     *              They also return only a URL, so the caller cannot relate the
     *              result back to a record; this returns a map so it can.
     *
     *              Lives here so the ContentDistribution settings are defined in
     *              exactly one place. KenGalleryController delegates to it for the
     *              gallery's public links.
     *
     *              ContentDownloadUrl is generated by the platform on save, so it
     *              is read back after the insert. ContentDownloadUrl rather than
     *              DistributionPublicUrl: the latter is a branded landing page,
     *              which an <img> cannot render.
     *
     * @param contentVersionIds ContentVersions that are already saved.
     * @return                  ContentVersion Id -> public download URL. Ids that
     *                          produced no URL are simply absent.
     */
    public static Map<Id, String> createDistributions(Set<Id> contentVersionIds) {
        return createDistributions(contentVersionIds, false);
    }

    /**
     * @description As above, but able to skip the user-permission check.
     *
     *              Community members do not hold "Create Public Links"
     *              (PermissionsManageContentLinks), so a user-mode insert fails
     *              for them and they would get no link at all - leaving a broken
     *              image for every other member of the group. Callers that
     *              publish on behalf of a portal member (the group feed) pass
     *              false and the insert runs in system mode on their behalf.
     *              Verified against AlumniDev with a portal user.
     *
     *              The single-argument overload and the create* helpers above
     *              publish in system mode for the same reason. Passing true
     *              inserts in user mode, so the running user's own permission to
     *              create content deliveries is enforced; the insert is
     *              allOrNone=false, so a user without it simply gets no URL back.
     *
     * @param enforceUserPermission whether the running user must personally hold
     *        the permission to create content deliveries.
     */
    public static Map<Id, String> createDistributions(
        Set<Id> contentVersionIds,
        Boolean enforceUserPermission
    ) {
        Map<Id, String> urlByVersionId = new Map<Id, String>();
        if (contentVersionIds == null || contentVersionIds.isEmpty()) {
            return urlByVersionId;
        }

        List<ContentDistribution> distributions = new List<ContentDistribution>();
        for (ContentVersion cv : [
            SELECT Id, Title FROM ContentVersion WHERE Id IN :contentVersionIds WITH SYSTEM_MODE
        ]) {
            ContentDistribution dist = new ContentDistribution();
            dist.Name = String.isBlank(cv.Title) ? 'File' : cv.Title;
            dist.ContentVersionId = cv.Id;
            dist.PreferencesLinkLatestVersion = true;
            dist.PreferencesAllowViewInBrowser = true;
            dist.PreferencesNotifyOnVisit = false;
            distributions.add(dist);
        }
        if (distributions.isEmpty()) {
            return urlByVersionId;
        }
        if (enforceUserPermission == false) {
            Database.insert(distributions, false, AccessLevel.SYSTEM_MODE);
        } else {
            Database.insert(distributions, false, AccessLevel.USER_MODE);
        }

        for (ContentDistribution dist : [
            SELECT ContentVersionId, ContentDownloadUrl
            FROM ContentDistribution
            WHERE Id IN :distributions
            WITH SYSTEM_MODE
        ]) {
            if (String.isNotBlank(dist.ContentDownloadUrl)) {
                urlByVersionId.put(dist.ContentVersionId, dist.ContentDownloadUrl);
            }
        }
        return urlByVersionId;
    }

    /**
     *@description Creates multiple ContentVersion records from a map of
     *              file titles to Base64-encoded content and returns
     *              downloadable URLs for each file. 
     * Behavior:
     * - Skips work and returns an empty map if the input is null/empty.
     * - Inserts ContentVersion and then creates ContentDistribution pointing to each version.
     * - Returns the ContentDownloadUrl for each created distribution keyed by title.
     *
     * @param titleToBase64Map  Map of file titles to Base64-encoded bodies.
     * @return                  Map of file titles to downloadable URLs.
     */
    public static Map<String, String> createMultipleContentVersions(Map<String, String> titleToBase64Map) {
        Map<String, String> titleToUrlMap = new Map<String, String>();
        if (titleToBase64Map == null || titleToBase64Map.isEmpty()) {
            return titleToUrlMap;
        }

        // Build ContentVersion list
        List<ContentVersion> contentVersions = new List<ContentVersion>();
        for (String title : titleToBase64Map.keySet()) {
            Blob decodedData = EncodingUtil.base64Decode(titleToBase64Map.get(title));
            ContentVersion cv = new ContentVersion();
            cv.Title = title;
            cv.PathOnClient = title;
            cv.VersionData = decodedData;
            contentVersions.add(cv);
        }

        // Insert ContentVersions (single decision, no nested if)
        if (!contentVersions.isEmpty() && Schema.sObjectType.ContentVersion.isCreateable()) {
            insert contentVersions;
        }

        // Build ContentDistribution list
        List<ContentDistribution> distributions = new List<ContentDistribution>();
        for (ContentVersion cv : contentVersions) {
            ContentDistribution dist = new ContentDistribution();
            dist.Name = cv.Title;
            dist.ContentVersionId = cv.Id;
            dist.PreferencesLinkLatestVersion = true;
            dist.PreferencesAllowViewInBrowser = true;
            dist.PreferencesNotifyOnVisit = false;
            distributions.add(dist);
        }

        // Insert ContentDistributions (single decision, no nested if)
        if (!distributions.isEmpty()) {
            Database.insert(distributions, false, AccessLevel.SYSTEM_MODE);
        }

        // Fetch created distributions and build the return map
        Map<Id, ContentDistribution> distMap = new Map<Id, ContentDistribution>([
            SELECT Id, Name, DistributionPublicUrl, ContentDownloadUrl
            FROM ContentDistribution
            WHERE Id IN :distributions
            WITH SYSTEM_MODE
        ]);

        for (ContentDistribution dist : distMap.values()) {
            // Keep using ContentDownloadUrl per existing behavior
            titleToUrlMap.put(dist.Name, dist.ContentDownloadUrl);
        }

        return titleToUrlMap;
    }


}