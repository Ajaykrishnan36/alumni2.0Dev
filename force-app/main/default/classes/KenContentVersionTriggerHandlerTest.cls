/**
 * @description Covers the standard-UI upload path: a file attached straight to a
 *              Ken_File__c record has to get a public link even though it never
 *              goes through KenGalleryController.
 */
@IsTest
private class KenContentVersionTriggerHandlerTest {
  private static Ken_File__c newGalleryFile() {
    Ken_Album__c album = new Ken_Album__c(Name = 'Convocation 2024');
    insert album;
    Ken_File__c file = new Ken_File__c(Album__c = album.Id, Name = 'group.png');
    insert file;
    return file;
  }

  /**
   * FirstPublishLocationId is what the standard Files UI sets when you upload
   * against a record, and is the only signal the trigger has to work from.
   */
  @IsTest
  static void testUploadAgainstGalleryFileGetsPublicLink() {
    Ken_File__c file = newGalleryFile();

    Test.startTest();
    insert new ContentVersion(
      Title = 'group.png',
      PathOnClient = 'group.png',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = file.Id
    );
    Test.stopTest();

    // ContentDownloadUrl is generated by the platform and is not reliably
    // populated in a test context, so assert the distribution itself exists -
    // that is what makes the file readable without a login.
    System.assertEquals(
      1,
      [SELECT COUNT() FROM ContentDistribution],
      'A file attached to a gallery record must be published, or Public URL stays blank on the Details page.'
    );
  }

  /**
   * The Setup-upload regression. The record Name is typed by hand here, so it
   * commonly has no extension - "vgh,." holding a JPEG is a real case from
   * AlumniDev. Is_Image__c has to come from the attached file, not the name, or
   * the landing page silently drops a genuine newsletter image.
   */
  @IsTest
  static void testIsImageIsStampedFromTheFileNotTheRecordName() {
    Ken_File__c file = newGalleryFile();
    file.Name = 'vgh,.';
    update file;

    Test.startTest();
    insert new ContentVersion(
      Title = 'WhatsApp Image 2026-02-17 at 20.52.25',
      PathOnClient = 'whatsapp.jpeg',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = file.Id
    );
    Test.stopTest();

    System.assertEquals(
      true,
      [SELECT Is_Image__c FROM Ken_File__c WHERE Id = :file.Id].Is_Image__c,
      'A JPEG must be stamped as an image however the record itself is named.'
    );
  }

  /**
   * The other direction: a document must be recorded as a document, so the
   * landing page keeps it off the page instead of rendering a broken cover.
   */
  @IsTest
  static void testIsImageIsFalseForADocumentUpload() {
    Ken_File__c file = newGalleryFile();

    Test.startTest();
    insert new ContentVersion(
      Title = 'October Newsletter',
      PathOnClient = 'october.pdf',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = file.Id
    );
    Test.stopTest();

    System.assertEquals(
      false,
      [SELECT Is_Image__c FROM Ken_File__c WHERE Id = :file.Id].Is_Image__c,
      'A PDF must not be stamped as an image.'
    );
  }

  /**
   * The trigger fires for every file uploaded anywhere in the org, so a file
   * that has nothing to do with the gallery must be left completely alone.
   */
  @IsTest
  static void testUploadAgainstUnrelatedRecordIsIgnored() {
    Account acc = new Account(Name = 'Somaiya Trust');
    insert acc;

    Test.startTest();
    insert new ContentVersion(
      Title = 'prospectus.pdf',
      PathOnClient = 'prospectus.pdf',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = acc.Id
    );
    Test.stopTest();

    System.assertEquals(
      0,
      [SELECT COUNT() FROM ContentDistribution],
      'Only gallery files are published; an unrelated upload must not be made public.'
    );
  }

  /**
   * A file uploaded with no parent record cannot be a gallery file, and the
   * trigger must not blow up on the null FirstPublishLocationId.
   */
  @IsTest
  static void testUploadWithNoParentRecordIsIgnored() {
    Test.startTest();
    insert new ContentVersion(
      Title = 'loose.png',
      PathOnClient = 'loose.png',
      VersionData = Blob.valueOf('test')
    );
    Test.stopTest();

    System.assertEquals(0, [SELECT COUNT() FROM ContentDistribution]);
  }

  /**
   * Re-uploading against a file that already has a link must not create a
   * second ContentDistribution for the same record.
   */
  @IsTest
  static void testExistingPublicUrlIsNotRepublished() {
    Ken_File__c file = newGalleryFile();
    file.Public_URL__c = 'https://example.file.force.com/sfc/dist/version/download/existing';
    update file;

    Test.startTest();
    insert new ContentVersion(
      Title = 'group-v2.png',
      PathOnClient = 'group-v2.png',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = file.Id
    );
    Test.stopTest();

    System.assertEquals(
      0,
      [SELECT COUNT() FROM ContentDistribution],
      'A file that already carries a link must not pile up duplicate distributions.'
    );
    Ken_File__c after = [SELECT Public_URL__c FROM Ken_File__c WHERE Id = :file.Id];
    System.assertEquals(
      'https://example.file.force.com/sfc/dist/version/download/existing',
      after.Public_URL__c,
      'The existing link must be left untouched.'
    );
  }

  /**
   * A Setup upload is linked internal-only by the platform, which makes the
   * image unreadable in the portal. The trigger has to open it up.
   */
  @IsTest
  static void testUploadIsOpenedUpToPortalUsers() {
    Ken_File__c file = newGalleryFile();

    Test.startTest();
    insert new ContentVersion(
      Title = 'group.png',
      PathOnClient = 'group.png',
      VersionData = Blob.valueOf('test'),
      FirstPublishLocationId = file.Id
    );
    Test.stopTest();

    ContentDocumentLink link = [
      SELECT ShareType, Visibility
      FROM ContentDocumentLink
      WHERE LinkedEntityId = :file.Id
      LIMIT 1
    ];
    System.assertEquals('AllUsers', link.Visibility,
      'A portal user cannot read an InternalUsers file, so the gallery image would break.');
    System.assertEquals('V', link.ShareType);
  }
}