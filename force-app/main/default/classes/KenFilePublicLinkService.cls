/**
 * @description Generates the anonymously reachable download link for a gallery
 *              file and parks it on Ken_File__c.Public_URL__c, so the link is
 *              visible on the file's Details page without an admin having to
 *              open the Files UI and create one by hand.
 *
 *              EVERY uploaded file gets a link, not only newsletters. That is a
 *              deliberate product decision: a ContentDistribution link needs no
 *              login, so any file that has one is readable by anyone holding
 *              the URL. The portal itself never needs these links - it renders
 *              images through session-authenticated shepherd URLs - so the only
 *              consumer is the landing page and an admin copying a link.
 *
 *              Shared by both upload paths so the link is produced identically:
 *              KenGalleryController.uploadPhotos() for the portal, and
 *              KenContentVersionTriggerHandler for a file attached through the
 *              standard Salesforce UI.
 *
 *              Best-effort by design. If public links are disabled in the org
 *              the upload itself must still succeed, so a failure here leaves
 *              Public_URL__c blank rather than rolling the transaction back.
 */
public without sharing class KenFilePublicLinkService {
  /**
   * @param versionByFileId the ContentVersion that was uploaded, keyed by the
   *        Ken_File__c record it belongs to. Both must already be inserted -
   *        ContentDistribution needs a real ContentVersion Id.
   */
  public static void publish(Map<Id, ContentVersion> versionByFileId) {
    if (versionByFileId == null || versionByFileId.isEmpty()) {
      return;
    }
    if (!Schema.sObjectType.ContentDistribution.isCreateable()) {
      return;
    }

    try {
      // A file that already carries a link keeps it, so re-uploading against
      // the same record cannot pile up duplicate ContentDistribution rows.
      List<Id> pending = new List<Id>();
      for (Ken_File__c f : [
        SELECT Id, Public_URL__c
        FROM Ken_File__c
        WHERE Id IN :versionByFileId.keySet()
      ]) {
        if (String.isBlank(f.Public_URL__c)) {
          pending.add(f.Id);
        }
      }
      if (pending.isEmpty()) {
        return;
      }

      List<ContentDistribution> distributions = new List<ContentDistribution>();
      for (Id fileId : pending) {
        ContentVersion cv = versionByFileId.get(fileId);
        ContentDistribution dist = new ContentDistribution();
        dist.Name = String.isBlank(cv.Title) ? 'Gallery File' : cv.Title;
        dist.ContentVersionId = cv.Id;
        dist.PreferencesLinkLatestVersion = true;
        dist.PreferencesAllowViewInBrowser = true;
        dist.PreferencesNotifyOnVisit = false;
        distributions.add(dist);
      }
      insert distributions;

      // ContentDownloadUrl is generated by the platform on save, so it can only
      // be read back after the insert.
      Map<Id, String> urlByDistribution = new Map<Id, String>();
      for (ContentDistribution dist : [
        SELECT Id, ContentDownloadUrl
        FROM ContentDistribution
        WHERE Id IN :distributions
      ]) {
        urlByDistribution.put(dist.Id, dist.ContentDownloadUrl);
      }

      List<Ken_File__c> updates = new List<Ken_File__c>();
      for (Integer i = 0; i < pending.size(); i++) {
        String url = urlByDistribution.get(distributions[i].Id);
        if (String.isBlank(url)) {
          continue;
        }
        updates.add(new Ken_File__c(Id = pending[i], Public_URL__c = url));
      }
      if (!updates.isEmpty()) {
        update updates;
      }
    } catch (Exception e) {
      // Public_URL__c stays blank. The gallery still works, and the landing
      // page falls back to its static cards.
    }
  }

  /**
   * @description Makes a gallery file readable by portal users.
   *
   *              A file uploaded through the standard Salesforce UI is linked
   *              with ShareType 'I' / Visibility 'InternalUsers', which an
   *              Experience Cloud user cannot read - the gallery renders a
   *              shepherd URL, so the image simply comes back broken. The
   *              portal's own upload path sets 'V'/'AllUsers' explicitly, so
   *              this brings hand-uploaded files up to the same footing.
   *
   *              Returns how many share rows it FOUND, not how many it changed.
   *              Zero means the platform has not written the link yet, which is
   *              the only case worth retrying asynchronously - a link that was
   *              already correct needs no retry.
   */
  public static Integer openUpToPortalUsers(Set<Id> fileIds) {
    if (fileIds == null || fileIds.isEmpty()) {
      return 0;
    }
    try {
      List<ContentDocumentLink> links = [
        SELECT Id, ShareType, Visibility
        FROM ContentDocumentLink
        WHERE LinkedEntityId IN :fileIds
      ];
      List<ContentDocumentLink> fixes = new List<ContentDocumentLink>();
      for (ContentDocumentLink link : links) {
        if (link.Visibility == 'AllUsers' && link.ShareType == 'V') {
          continue;
        }
        link.ShareType = 'V';
        link.Visibility = 'AllUsers';
        fixes.add(link);
      }
      if (!fixes.isEmpty()) {
        update fixes;
      }
      return links.size();
    } catch (Exception e) {
      // Leave the link as-is rather than failing the upload. The file stays
      // internal-only and the portal shows the placeholder. Reporting a row as
      // found stops a doomed async retry from being queued.
      return 1;
    }
  }
}