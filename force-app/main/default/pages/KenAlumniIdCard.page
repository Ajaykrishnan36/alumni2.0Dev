<apex:page controller="KenAlumniIdCardController"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyBodyTag="false"
           applyHtmlTag="false">
<html>
<head>
<style type="text/css">
    @page { size: 3.375in 2.125in; margin: 0; }
    body  { margin: 0; padding: 0; width: 3.375in; height: 2.125in; }
    p     { margin: 0; padding: 0; }
</style>
</head>
<body>

<table width="100%" height="100%"
       bgcolor="#4254EE"
       cellspacing="0" cellpadding="0"
       style="width:3.375in;height:2.125in;background-color:#4254EE;table-layout:fixed;">
<tr>

    <!-- LEFT: name / id / program / QR -->
    <td width="59%" valign="top"
        style="padding:0.18in 0.08in 0.12in 0.18in;vertical-align:top;">

        <p style="font-family:Arial,Helvetica,sans-serif;font-size:14pt;font-weight:bold;color:#ffffff;margin:0 0 4px 0;">{!alumniName}</p>
        <p style="font-family:Arial,Helvetica,sans-serif;font-size:10pt;color:#ffffff;margin:0 0 3px 0;">{!registrationNumber}</p>
        <p style="font-family:Arial,Helvetica,sans-serif;font-size:9pt;color:#cdd5ff;margin:0 0 10px 0;">{!programLabel}</p>

        <!-- QR: pre-fetched by Queueable, embedded as base64 data URI -->
        <apex:outputPanel rendered="{!hasQrCode}">
            <table cellspacing="0" cellpadding="0">
                <tr>
                    <td bgcolor="#ffffff" style="background-color:#ffffff;padding:4px;border-radius:5px;line-height:0;">
                        <img src="data:image/png;base64,{!qrBase64}"
                             width="72" height="72" style="display:block;"/>
                    </td>
                </tr>
            </table>
        </apex:outputPanel>

    </td>

    <!-- MIDDLE: profile photo -->
    <td width="28%" valign="top"
        style="padding:0.18in 0.06in 0 0;text-align:center;vertical-align:top;">

        <apex:outputPanel rendered="{!hasPhoto}">
            <img src="{!photoUrl}" width="82" height="90"
                 style="display:block;margin:0 auto;border-radius:5px;"/>
        </apex:outputPanel>

    </td>

    <!-- RIGHT: graduation year vertically -->
    <td width="13%" valign="middle"
        style="padding-right:0.1in;text-align:center;vertical-align:middle;">

        <apex:repeat value="{!yearChars}" var="c">
            <p style="font-family:Arial,Helvetica,sans-serif;font-size:12pt;font-weight:bold;color:#ffffff;text-align:center;margin:0;line-height:1.25;">{!c}</p>
        </apex:repeat>

    </td>

</tr>
</table>

</body>
</html>
</apex:page>